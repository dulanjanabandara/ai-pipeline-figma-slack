# LLM (agents use google/gemini-2.5-flash by default — free tier via https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# Alternative providers (swap the model string in src/mastra/agents/*.ts to match):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Force mock integrations (recommended for first demo)
DRY_RUN=true

# Default GitHub repo for /ship-design when omitted
DEFAULT_GITHUB_REPO=acme/demo-app

# Skip human approve step even in live mode
# SKIP_DEPLOY_APPROVAL=true

# Figma (REST + optional MCP)
FIGMA_ACCESS_TOKEN=
# Set to true to skip the figma-developer-mcp handshake (useful if you're
# hitting Figma's account-level rate limit, since the MCP server independently
# consumes the same quota on every process start).
# DISABLE_FIGMA_MCP=true

# GitHub (REST + optional MCP)
GITHUB_TOKEN=

# Linear (REST + optional MCP)
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Railway
RAILWAY_TOKEN=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_PUBLIC_URL=

# Slack Bot (control plane) — Socket Mode recommended for local demos
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_CHANNEL="#ai-pipeline"
# SLACK_WEBHOOK_URL=   # optional alternative for outbound-only notifies
# SLACK_BOLT_PORT=3001 # only if not using Socket Mode
