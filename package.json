{
  "name": "ai-agent-pipeline",
  "private": true,
  "version": "1.0.0",
  "description": "End-to-end AI agent workflow: Figma → React → GitHub → Linear → Railway → Slack",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w orchestrator",
    "dev:orchestrator": "npm run dev -w orchestrator",
    "dev:demo": "npm run dev -w demo-app",
    "slack:bot": "npm run slack:bot -w orchestrator",
    "build": "npm run build -w @ai-pipeline/shared && npm run build -w orchestrator && npm run build -w demo-app",
    "build:orchestrator": "npm run build -w orchestrator",
    "build:demo": "npm run build -w demo-app",
    "start": "npm run start -w orchestrator"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "zod": "^4.4.3"
  },
  "license": "MIT"
}
